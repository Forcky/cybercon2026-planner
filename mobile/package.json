{
  "name": "cc26-planner-app",
  "version": "0.1.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "icons": "python3 scripts/icons.py || python scripts/icons.py",
    "prebuild": "npm run icons && expo prebuild --platform android",
    "android": "npm run icons && expo run:android --variant release",
    "test": "node --test \"test/*.test.mjs\"",
    "eas-build-post-install": "python3 -m venv /tmp/cc26-icons && /tmp/cc26-icons/bin/pip install --quiet -r ../requirements.txt && /tmp/cc26-icons/bin/python scripts/icons.py"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.9",
    "expo-build-properties": "~57.0.8",
    "expo-file-system": "~57.0.6",
    "expo-notifications": "~57.0.8",
    "expo-sharing": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-webview": "13.16.1"
  }
}
